# Copy this file to .env and paste your Materials Project API key.
# Get one at https://next-gen.materialsproject.org/api (logged in -> API key).
# .env is gitignored; the harness never prints or logs this value.
MP_API_KEY=

# Optional: phone push notifications for unattended runs via ntfy.sh (off while empty).
# Use a long random topic name — anyone who knows it can read the messages.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
