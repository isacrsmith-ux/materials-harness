# Secrets — never commit
.env
.env.*
!.env.example

# Environments and tool caches (all kept project-local)
.venv/
.envs/
.tools/
.uv-cache/
.uv-python/
__pycache__/
*.pyc
.pytest_cache/
.mplconfig/

# Downloaded / generated data
cache/
models/
logs/
config/launchd/
reports/[0-9]*/

# macOS
.DS_Store

# --- added by the pre-publication audit (reports/publish_audit.md) ---
# Nothing below is tracked today; these rules stop a future commit from adding one by accident.

# Credentials and keys of every flavour
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
.netrc
.npmrc
.pypirc
service-account*.json
*service_account*.json
*credentials*.json
secrets.yml
secrets.yaml
*.tfvars
kubeconfig
# (public keys are fine and deliberately not ignored: *.pub)

# Databases and run state, wherever they land
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.parquet

# results/ is generated and huge (~1 GB of SQLite), but two files are published:
# the exported table and its data dictionary. The directory is excluded with
# results/* rather than results/, because git does not descend into an excluded
# directory and a negation inside one can never match.
results/*
!results/README.md
!results/results.parquet
# written by `python -m harness checkpoint`: the databases' schema and counts, small and diffable
!results/schema.sql
!results/summary.json
# The aggregate public export. The directory is un-ignored so git descends into it; which files may
# actually live here is enforced by name in scripts/preflight_publish.sh, not by this pattern.
!results/public/

# Model checkpoints, wherever they land (models/ above covers the usual place)
*.model
*.pt
*.pth
*.ckpt
*.safetensors

# Local backups (scripts/backup.sh default destination)
backups/

# Scratch
scratch/
tmp/
*.tmp

# campaign driver run state: local, may hold absolute paths; summarised in reports/campaign_20260924_summary.md
data/campaign_20260924_state.json
